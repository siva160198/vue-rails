#!/usr/bin/env ruby
require_relative "../lib/postgres_command"
backup = ARGV.fetch(0) { abort "Usage: bin/restore /absolute/path/to/backup.dump" }
abort "Backup does not exist" unless File.file?(backup)
abort "Set RESTORE_CONFIRM=restore to continue" unless ENV["RESTORE_CONFIRM"] == "restore"

database_url = ENV.fetch("DATABASE_URL")
abort "Restore failed" unless PostgresCommand.run("pg_restore", [ "--clean", "--if-exists", "--no-owner", "--no-acl", File.expand_path(backup), "--dbname" ], database_url: database_url)
puts "Restore completed"
