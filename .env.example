# Public application URLs
APP_HOST=app.example.com
FRONTEND_URL=https://app.example.com
# Set only when the frontend is hosted on a different origin.
# FRONTEND_ORIGIN=https://frontend.example.com

# Rails and PostgreSQL
RAILS_MASTER_KEY=
DATABASE_URL=postgresql://user:password@database.example.com/application_production
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Required production email configuration
MAILER_FROM=no-reply@example.com
SUPPORT_EMAIL=example@mail.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS_AUTO=true

# Optional exception monitoring. Keep blank to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Public frontend DSN values are injected at Docker build time.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
APP_ENV=production
APP_RELEASE=
VITE_APP_ENV=production
VITE_APP_RELEASE=

# TLS is enabled by default in production.
ASSUME_SSL=true
FORCE_SSL=true
HSTS_PRELOAD=false
# Operational retention and backup defaults
BACKUP_DIRECTORY=../backups
BACKUP_RETENTION_DAYS=14
SESSION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
MAX_ACTIVE_SESSIONS=10
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_DAYS=30
ADMIN_SESSION_ABSOLUTE_HOURS=12
ADMIN_MFA_REQUIRED=true
MFA_REQUIRED_ROLES=admin
# Optional four-eyes approval for admin role, permission, and account-access changes.
ADMIN_DUAL_CONTROL_ENABLED=false
# Optional privacy-preserving breached-password lookup (HIBP k-anonymity API).
PASSWORD_BREACH_CHECK_ENABLED=false
# Optional ClamAV upload scanning. Production fails the upload closed when enabled.
MALWARE_SCAN_ENABLED=false
CLAMSCAN_PATH=/usr/bin/clamscan
MALWARE_SCAN_TIMEOUT_SECONDS=10
# Optional adaptive CAPTCHA. Set both values or leave both blank.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Optional comma-separated CIDRs evaluated against Rails request.remote_ip.
TRUSTED_LOGIN_NETWORKS=
# Optional passkeys. Set both values or leave both blank.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Vue Rails
QUEUE_MAX_LATENCY_SECONDS=300
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
